BETTER_AUTH_SECRET=
# Локально: http://localhost:3000
BETTER_AUTH_URL=
# Локально: smtp://127.0.0.1:1025 (Mailpit)
SMTP_URL=
# Почта владельца существующих данных; не добавляйте её в git.
OWNER_EMAIL=
